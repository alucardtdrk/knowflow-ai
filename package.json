{
  "name": "knowflow-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "worker": "tsx --env-file-if-exists=.env scripts/worker.ts",
    "test:e2e:live": "playwright test --config playwright.live.config.ts",
    "format": "prettier --write src tests e2e scripts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@electric-sql/pglite-pgvector": "^0.0.16",
    "@electric-sql/pglite-socket": "^0.2.18",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "pdfkit": "^0.20.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1163.0",
    "better-auth": "^1.7.18",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.69.0",
    "mammoth": "^1.13.0",
    "next": "^16.4.5",
    "openai": "^7.52.0",
    "pdf-parse": "^2.4.5",
    "postgres": "^4.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "type": "module",
  "description": "Conhecimento que resolve: assistente documental para equipes, com fontes e encaminhamento humano.",
  "engines": {
    "node": ">=22.17.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "optionalDependencies": {
    "@next/swc-win32-x64-msvc": "^16.4.5",
    "@rolldown/binding-win32-x64-msvc": "^1.3.0",
    "@unrs/resolver-binding-win32-x64-msvc": "^1.13.0"
  }
}
