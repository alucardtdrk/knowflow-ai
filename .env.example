# Copy to .env; generate a random secret (at least 32 characters).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
DATABASE_URL=postgres://knowflow:knowflow_local@localhost:5432/knowflow
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=knowflow
S3_ACCESS_KEY_ID=knowflow
S3_SECRET_ACCESS_KEY=knowflow_local_storage
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Enable only in your local development database to create fictional accounts.
ALLOW_LOCAL_SEED=false
