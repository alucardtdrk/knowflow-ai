# Copy to .env; generate a random secret (at least 32 characters).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
DATABASE_URL=postgres://knowflow:knowflow_local@localhost:55432/knowflow
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=knowflow
S3_ACCESS_KEY_ID=knowflow
S3_SECRET_ACCESS_KEY=knowflow_local_storage
TOQAN_API_KEY=
# Optional; the model is configured in the Toqan agent.
TOQAN_BASE_URL=https://api.toqan.ai/api
# Enable only in your local development database to create fictional accounts.
ALLOW_LOCAL_SEED=false
